[user]
        name = name-default
        email = email-default
[core]
        quotepath = false
        hooksPath = ~/.git-hooks
[credential]
        helper = store

[includeIf "gitdir:~/path/to/private/*/"]
        path = ~/.gitconfig-private
[includeIf "gitdir:~/path/to/work/*/"]
        path = ~/.gitconfig-work

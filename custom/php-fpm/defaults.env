# php-fpm 定制默认值（由 docker-compose.custom.yml include 引入，
# 供 custom/php-fpm/compose.yml 及 php-fpm-73/83 变体的 build args 插值）。
# 敏感参数不放这里，保留在 .env。

# 安装开关（对应上游 php-fpm/compose.yml 的 INSTALL_* build args）
PHP_FPM_INSTALL_PING=true
PHP_FPM_INSTALL_XDEBUG=true
PHP_FPM_INSTALL_PCNTL=true
PHP_FPM_INSTALL_CACHETOOL=true
PHP_FPM_INSTALL_CALENDAR=true

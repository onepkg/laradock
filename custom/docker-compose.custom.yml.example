# docker-compose.custom.yml.example —— Laradock 自定义扩展示例模板
# 使用：复制本文件到仓库根目录，改名为 docker-compose.custom.yml
# （根目录同名文件被 .gitignore 忽略，属个人配置，不会误提交）。
# 加载方式：.env 中 COMPOSE_FILE=docker-compose.yml:docker-compose.custom.yml
# 依赖 .env 变量：VOLUMES_DRIVER、GITHUB_PROXY
#
# 结构：
#   1. include —— 加载 PHP 版本变体（custom/php-fpm-73|83/compose.yml）
#   2. volumes —— 顶层命名卷轴
#   3. 覆盖区 —— workspace / php-fpm 系容器统一挂载与构建参数（YAML anchor）
#   4. 自定义服务区 —— example-service 模板

include:
  # workspace 定制（extends 上游，覆盖 build args，值来自 custom/workspace/defaults.env）
  - path: custom/workspace/compose.yml
    project_directory: .
    env_file:
      - workspace/defaults.env
      - custom/workspace/defaults.env
  # php-fpm 定制（extends 上游，安装开关等值来自 custom/php-fpm/defaults.env）
  - path: custom/php-fpm/compose.yml
    project_directory: .
    env_file:
      - php-fpm/defaults.env
      - custom/php-fpm/defaults.env
  # PHP 7.3 / 8.3 版本变体（仅 php-fpm 系；workspace 变体已舍去，
  # 变体 extends 上游并共享 custom/php-fpm/defaults.env）
  - path: custom/php-fpm-73/compose.yml
    project_directory: .
    env_file:
      - php-fpm/defaults.env
      - custom/php-fpm/defaults.env
  - path: custom/php-fpm-83/compose.yml
    project_directory: .
    env_file:
      - php-fpm/defaults.env
      - custom/php-fpm/defaults.env
  # 自定义服务：每服务一个 custom/<name>/compose.yml（services + 顶层 volumes），
  # 此处追加 include 即生效，如 custom/mysql57/compose.yml、custom/v2raya/compose.yml
  - path: custom/PyTorch/compose.yml
    project_directory: .
  - path: custom/v2raya/compose.yml
    project_directory: .
  - path: custom/dbx/compose.yml
    project_directory: .
  - path: custom/headroom/compose.yml
    project_directory: .
  - path: custom/redis-master-slave-sentinel/compose.yml
    project_directory: .
  - path: custom/mysql57/compose.yml
    project_directory: .
  - path: custom/mysql80/compose.yml
    project_directory: .

volumes:
  # 代码命名卷轴（不落宿主机盘）
  projects-data:
    driver: ${VOLUMES_DRIVER}
  # 自定义服务示例数据卷
  example-data:
    driver: ${VOLUMES_DRIVER}
  headroom-data:
    driver: ${VOLUMES_DRIVER}
  dbx-data:
    driver: ${VOLUMES_DRIVER}
  # workspace 专属卷（vscode-server、home-*、mysql 等）已随 workspace
  # 服务迁至 custom/workspace/compose.yml 顶层声明

services:

  # ========== 覆盖区：统一配置（仅追加，保留原有挂载/参数） ==========
  # workspace 主体已迁移至 custom/workspace/compose.yml（volumes/build/environment）。
  # 此处按需追加 workspace 挂载（如 projects-data 代码卷），可自由增删：
  # 改这一块即可，无需动 custom/workspace/compose.yml 模板。
  # php-fpm 系：&projects-data 卷锚点 + &github-proxy 构建参数
  # （YAML 锚点不能跨文件，php-fpm 系用的 &github-proxy 需在本文件重新定义）。
  # 新增变体：按所属系照抄 volumes / build.args 引用行。

  # workspace 按需挂载区：projects-data 代码卷（进命名卷，不落宿主机盘）
  workspace:
    volumes: &workspace-vols
      - projects-data:/var/www/projects
      # workspace 额外自定义挂载写这里（自动合并进 custom/workspace/compose.yml）
      # - ./custom/workspace/<源>:<容器路径>:ro

  php-fpm:
    volumes: &projects-data
      - projects-data:/var/www/projects
    build:
      args: &github-proxy
        - GITHUB_PROXY=${GITHUB_PROXY}
  nginx:
    volumes: *projects-data
  php-fpm-73:
    volumes: *projects-data
    build:
      args: *github-proxy
  php-fpm-83:
    volumes: *projects-data
    build:
      args: *github-proxy

  # ========== 自定义服务 ==========

  example-service:
    # 自定义服务模板：复制本块 + custom/example-service/ 目录，改名即为新服务
    build:
      context: ./custom/example-service
    restart: always
    volumes:
      - example-data:/data
    networks:
      - backend

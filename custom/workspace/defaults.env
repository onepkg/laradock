# workspace 定制默认值（由 docker-compose.custom.yml include 引入，
# 供 custom/workspace/compose.yml 的 build args 及依赖它的服务插值）。
# 敏感参数（token 等）不放这里，保留在 .env。

# 镜像源
WORKSPACE_NVM_NODEJS_ORG_MIRROR=https://registry.npmmirror.com
WORKSPACE_NPM_REGISTRY=https://registry.npmmirror.com

# 安装开关
WORKSPACE_INSTALL_PNPM=true
WORKSPACE_INSTALL_WORKSPACE_SSH=true
WORKSPACE_INSTALL_PYTHON3=true
WORKSPACE_INSTALL_SUPERVISOR=true
WORKSPACE_INSTALL_PING=true
WORKSPACE_INSTALL_DOCKER_CLIENT=true
WORKSPACE_INSTALL_EVENT=true
WORKSPACE_INSTALL_DNSUTILS=true

# 注：WORKSPACE_TIMEZONE 为跨服务共享变量（上游默认 .env 提供），
# 不放这里，保留在 .env 基础段。

# claude code（非敏感；token 等敏感参数保留在 .env）
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max
